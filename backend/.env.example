# Développement : copier vers backend/.env (make env). Valeurs effectives : make config

# --- Django ---
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=remplacer-par-une-cle-longue-et-aleatoire
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# DJANGO_LOG_LEVEL=INFO

# --- Base (ou POSTGRES_DB / USER / PASSWORD / HOST / PORT) ---
DATABASE_URL=postgres://<utilisateur>:<mot_de_passe>@localhost:5432/mini_ats

# --- HTTPS : désactivé par défaut en DEBUG ---
# SECURE_SSL_REDIRECT=False
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False
