DJANGO_SECRET_KEY=remplacer-par-une-cle-longue-et-aleatoire
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres existant sur la machine. Créer la base une fois :
#   docker exec -it postgres_db createdb -U <utilisateur> mini_ats
DATABASE_URL=postgres://<utilisateur>:<mot_de_passe>@localhost:5432/mini_ats
# docker-compose remplace localhost par host.docker.internal (DATABASE_HOST).

CORS_ALLOWED_ORIGINS=http://localhost:5173
