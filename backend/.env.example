# Variables de DÉVELOPPEMENT : copier vers backend/.env (make env), puis renseigner.
# Django lit ce fichier au démarrage (python-dotenv, dans config/settings.py).
# Une variable déjà définie dans l'environnement (CI, docker-compose) reste prioritaire.
# Voir les valeurs effectives : make config   (secrets masqués)
# En production, le .env est généré par deploy/setup_env_prod.sh : ne pas copier ce fichier.

# --- Django ---
DJANGO_DEBUG=True
# Facultatif en développement (clé de dev par défaut), obligatoire si DJANGO_DEBUG=False.
DJANGO_SECRET_KEY=remplacer-par-une-cle-longue-et-aleatoire
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# DJANGO_LOG_LEVEL=INFO

# --- Base : DATABASE_URL, ou à défaut POSTGRES_DB / USER / PASSWORD / HOST / PORT ---
# Créer la base une fois : docker exec -it postgres_db createdb -U <utilisateur> mini_ats
DATABASE_URL=postgres://<utilisateur>:<mot_de_passe>@localhost:5432/mini_ats
# Le docker-compose de dev remplace localhost par host.docker.internal (DATABASE_HOST).

# --- Sécurité HTTPS : inutile en local (désactivée par défaut quand DJANGO_DEBUG=True) ---
# SECURE_SSL_REDIRECT=False
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False
